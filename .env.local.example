# =============================================================================
# Variables de entorno — Pausa studio landing
# =============================================================================
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` NO se versiona (está en .gitignore).

# -----------------------------------------------------------------------------
# Resend — email transaccional para el form de contacto
# -----------------------------------------------------------------------------
# 1. Crear cuenta gratis en https://resend.com (3.000 emails/mes incluidos).
# 2. Verificar el dominio pausastudio.com.ar en Resend para que los mails salgan
#    como "hola@pausastudio.com.ar" y no como "via resend.dev".
# 3. Generar API key en https://resend.com/api-keys y pegarla acá.
RESEND_API_KEY=

# Dirección a la que llegan las consultas del form de contacto.
CONTACT_EMAIL_TO=hola@pausastudio.com.ar

# Remitente del email (debe ser un dominio verificado en Resend).
CONTACT_EMAIL_FROM=Pausa studio <hola@pausastudio.com.ar>

# -----------------------------------------------------------------------------
# WhatsApp
# -----------------------------------------------------------------------------
# Formato internacional sin "+" ni espacios. Ej: 5491134567890
# IMPORTANTE: dejar con X mientras no esté el chip dedicado.
# El botón flotante se renderiza pero queda deshabilitado ("Próximamente")
# hasta que este valor no contenga X.
NEXT_PUBLIC_WHATSAPP_NUMBER=549XXXXXXXXXX

# -----------------------------------------------------------------------------
# URL pública del sitio (para SEO, sitemap, OG tags)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://pausastudio.rest

# -----------------------------------------------------------------------------
# Precios — toggle temporal
# -----------------------------------------------------------------------------
# Mientras los precios no estén cerrados (negociación con taller), dejar en
# "false": las cards y la ficha muestran "A medida del espacio" en vez de "$X".
# Para volver a mostrar precios: poner "true" o borrar esta línea.
NEXT_PUBLIC_SHOW_PRICES=false

# -----------------------------------------------------------------------------
# Plazo de producción — toggle temporal
# -----------------------------------------------------------------------------
# La ficha de producto puede mostrar el "Plazo" de producción del sofá.
# Oculto por defecto para no exponer un plazo comprometido en público
# (guardrail de marca: no prometer plazos no sostenibles).
# Para mostrarlo: poner "true". Default (oculto): "false" o borrar esta línea.
NEXT_PUBLIC_SHOW_DELIVERY=false
